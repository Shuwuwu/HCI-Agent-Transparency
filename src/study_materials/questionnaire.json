{
  "version": "questionnaire_v2",
  "title": "Post Study Questions",
  "intro": "These questions are about the session as a whole, not one conversation.",
  "items": [
    {
      "id": "unsafe_meaning",
      "type": "text",
      "text": "What does unsafe AI assistant behaviour mean to you?",
      "required": true,
      "max_chars": 2000
    },
    {
      "id": "information_sufficient",
      "type": "scale",
      "text": "How sufficient was the available information for making your safety assessments?",
      "required": true,
      "min": 1,
      "max": 5,
      "anchors": {"1": "Not at all sufficient", "2": "Slightly sufficient", "3": "Moderately sufficient",
                  "4": "Very sufficient", "5": "Completely sufficient"}
    },
    {
      "id": "skill_docs_usefulness",
      "type": "scale",
      "text": "How useful was the skill documentation in making your safety assessments?",
      "required": true,
      "min": 1,
      "max": 5,
      "anchors": {"1": "Not at all useful", "2": "Slightly useful", "3": "Moderately useful", "4": "Very useful",
                  "5": "Extremely useful"},
      "not_applicable": {"id": "did_not_consult", "label": "Did not consult"}
    },
    {
      "id": "skill_docs_purpose_understood",
      "type": "scale",
      "text": "How well did you understand the purpose of the skill documentation?",
      "required": true,
      "min": 1,
      "max": 5,
      "anchors": {"1": "Not at all", "2": "Slightly", "3": "Moderately", "4": "Very well", "5": "Completely"}
    },
    {
      "id": "information_overload",
      "type": "scale",
      "text": "I felt overwhelmed by the amount of information available.",
      "required": true,
      "min": 1,
      "max": 5,
      "anchors": {"1": "Strongly disagree", "2": "Disagree", "3": "Neither agree nor disagree", "4": "Agree",
                  "5": "Strongly agree"}
    },
    {
      "id": "information_overload_explanation",
      "type": "text",
      "text": "Please explain your answer to the statement above.",
      "required": false,
      "max_chars": 2000
    },
    {
      "id": "information_relied_on",
      "type": "text",
      "text": "What information did you rely on most when making your safety assessments?",
      "required": true,
      "max_chars": 2000
    },
    {
      "id": "additional_information_wanted",
      "type": "text",
      "text": "What additional information, if any, would have helped you make your safety assessments?",
      "required": false,
      "max_chars": 2000
    },
    {
      "id": "activity_log_usefulness",
      "type": "scale",
      "text": "How useful was the assistant's activity log in making your safety assessments?",
      "required": true,
      "shown_with": "activity_log",
      "min": 1,
      "max": 5,
      "anchors": {"1": "Not at all useful", "2": "Slightly useful", "3": "Moderately useful", "4": "Very useful",
                  "5": "Extremely useful"}
    }
  ]
}
