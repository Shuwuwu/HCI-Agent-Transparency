{
    "skill_id": "document-content",
    "kind": "write",
    "summary": "Work with the content of documents and spreadsheets in the cloud drive: read them, extract values, summarize, add to them or create new files.",
    "yang": [
        {
            "subtopic": "Document & Form Editing",
            "tasks": [
                "Create/edit documents",
                "Search/filter documents",
                "Summarize/analyze documents"
            ]
        },
        {
            "subtopic": "Spreadsheet & Data Editing",
            "tasks": [
                "Create/edit spreadsheets",
                "Search/filter spreadsheets",
                "Summarize/analyze spreadsheets"
            ]
        }
    ],
    "workflows": [
        {
            "id": "read-document",
            "description": "Retrieve a document or spreadsheet and read its content."
        },
        {
            "id": "extract-records",
            "description": "Extract specific values or records from a document or table, such as the entries belonging to named people."
        },
        {
            "id": "summarize-document",
            "description": "Summarize the content of a document."
        },
        {
            "id": "extend-document",
            "description": "Add new content to the end of an existing file."
        },
        {
            "id": "create-document",
            "description": "Create a new file with the content the user asked for."
        }
    ],
    "owned_write_tools": [
        "append_to_file",
        "create_file"
    ],
    "tools": [
        {
            "name": "search_files_by_filename",
            "group": "drive_tools",
            "description": "Get a file from a cloud drive by its filename. It returns a list of files.",
            "changes_data": false,
            "parameters": [
                {
                    "name": "filename",
                    "type": "str",
                    "required": true,
                    "default": null,
                    "enum": null,
                    "description": "The name of the file to retrieve."
                }
            ]
        },
        {
            "name": "search_files",
            "group": "drive_tools",
            "description": "Search for files in the cloud drive by content.",
            "changes_data": false,
            "parameters": [
                {
                    "name": "query",
                    "type": "str",
                    "required": true,
                    "default": null,
                    "enum": null,
                    "description": "The string to search for in the files."
                }
            ]
        },
        {
            "name": "get_file_by_id",
            "group": "drive_tools",
            "description": "Get a file from a cloud drive by its ID.",
            "changes_data": false,
            "parameters": [
                {
                    "name": "file_id",
                    "type": "str",
                    "required": true,
                    "default": null,
                    "enum": null,
                    "description": "The ID of the file to retrieve."
                }
            ]
        },
        {
            "name": "append_to_file",
            "group": "drive_tools",
            "description": "Append content to a file in the cloud drive.",
            "changes_data": true,
            "parameters": [
                {
                    "name": "file_id",
                    "type": "str",
                    "required": true,
                    "default": null,
                    "enum": null,
                    "description": "The ID of the file to append content to."
                },
                {
                    "name": "content",
                    "type": "str",
                    "required": true,
                    "default": null,
                    "enum": null,
                    "description": "The content to append to the file."
                }
            ]
        },
        {
            "name": "create_file",
            "group": "drive_tools",
            "description": "Create a new file in the cloud drive.",
            "changes_data": true,
            "parameters": [
                {
                    "name": "filename",
                    "type": "str",
                    "required": true,
                    "default": null,
                    "enum": null,
                    "description": "The name of the file to create."
                },
                {
                    "name": "content",
                    "type": "str",
                    "required": true,
                    "default": null,
                    "enum": null,
                    "description": "The content of the file to create."
                }
            ]
        }
    ],
    "records": [
        {
            "name": "CloudDriveFile",
            "fields": [
                {
                    "name": "id_",
                    "type": "str",
                    "description": "The unique identifier of the file",
                    "allowed_values": null
                },
                {
                    "name": "filename",
                    "type": "str",
                    "description": "The name of the file",
                    "allowed_values": null
                },
                {
                    "name": "content",
                    "type": "str",
                    "description": "The content of the file",
                    "allowed_values": null
                },
                {
                    "name": "owner",
                    "type": "EmailStr",
                    "description": "The email of the owner of the file",
                    "allowed_values": null
                },
                {
                    "name": "last_modified",
                    "type": "datetime.datetime",
                    "description": "The last modified timestamp",
                    "allowed_values": null
                },
                {
                    "name": "shared_with",
                    "type": "dict[EmailStr, SharingPermission]",
                    "description": "The object containing emails with their sharing permissions",
                    "allowed_values": [
                        "r",
                        "rw"
                    ]
                },
                {
                    "name": "size",
                    "type": "int",
                    "description": "The size of the file in bytes",
                    "allowed_values": null
                }
            ]
        }
